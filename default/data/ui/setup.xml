<?xml version="1.0" encoding="UTF-8"?>
<setup page="configure">
  <title>Configure Trellix ePO Add-on</title>
  <subtitle>Configure connection settings for Trellix (McAfee) ePO server</subtitle>
  
  <block title="ePO Server Configuration" endpoint="ta_trellix_epo/ta_trellix_epo_settings/general" entity="general">
    <input field="epo_server">
      <label>ePO Server URL</label>
      <type>text</type>
    </input>
    
    <input field="epo_port">
      <label>ePO Server Port</label>
      <type>text</type>
    </input>
    
    <input field="use_ssl">
      <label>Use SSL/TLS</label>
      <type>checkbox</type>
    </input>
    
    <input field="verify_ssl">
      <label>Verify SSL Certificate</label>
      <type>checkbox</type>
    </input>
  </block>
  
  <block title="Authentication" endpoint="ta_trellix_epo/ta_trellix_epo_settings/general" entity="general">
    <input field="username">
      <label>ePO Username</label>
      <type>text</type>
    </input>
    
    <text>
      <content>Note: After saving, run the configure_credentials.py script to securely store your password:
      
      $SPLUNK_HOME/bin/splunk cmd python $SPLUNK_HOME/etc/apps/TA-trellix-epo/bin/configure_credentials.py</content>
    </text>
  </block>
  
  <block title="Collection Settings" endpoint="ta_trellix_epo/ta_trellix_epo_settings/general" entity="general">
    <input field="polling_interval">
      <label>Default Polling Interval (seconds)</label>
      <type>text</type>
    </input>
    
    <input field="batch_size">
      <label>Default Batch Size</label>
      <type>text</type>
    </input>
    
    <input field="timeout">
      <label>Request Timeout (seconds)</label>
      <type>text</type>
    </input>
    
    <input field="retry_attempts">
      <label>Retry Attempts</label>
      <type>text</type>
    </input>
    
    <input field="log_level">
      <label>Log Level</label>
      <type>dropdown</type>
      <options>
        <opt value="DEBUG" label="Debug"/>
        <opt value="INFO" label="Info"/>
        <opt value="WARNING" label="Warning"/>
        <opt value="ERROR" label="Error"/>
      </options>
    </input>
  </block>
  
  <block title="Proxy Settings (Optional)" endpoint="ta_trellix_epo/ta_trellix_epo_settings/proxy" entity="proxy">
    <input field="use_proxy">
      <label>Use Proxy</label>
      <type>checkbox</type>
    </input>
    
    <input field="proxy_server">
      <label>Proxy Server</label>
      <type>text</type>
    </input>
    
    <input field="proxy_port">
      <label>Proxy Port</label>
      <type>text</type>
    </input>
    
    <input field="proxy_username">
      <label>Proxy Username</label>
      <type>text</type>
    </input>
    
    <input field="proxy_password">
      <label>Proxy Password</label>
      <type>password</type>
    </input>
  </block>
</setup>
