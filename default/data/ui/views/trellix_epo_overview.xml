<form version="1.1" theme="dark">
  <label>Trellix ePO Security Overview</label>
  <description>Comprehensive security dashboard for Trellix (McAfee) ePO telemetry</description>
  
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time_range">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    
    <input type="multiselect" token="filter_host">
      <label>Host</label>
      <choice value="*">All Hosts</choice>
      <default>*</default>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <search>
        <query>index=* sourcetype="trellix_epo:*" | stats count by host | sort -count</query>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </search>
    </input>
    
    <input type="multiselect" token="filter_threat_type">
      <label>Threat Type</label>
      <choice value="*">All Types</choice>
      <default>*</default>
      <fieldForLabel>threat_type</fieldForLabel>
      <fieldForValue>threat_type</fieldForValue>
      <search>
        <query>index=* sourcetype="trellix_epo:threat_events" | stats count by threat_type | sort -count</query>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </search>
    </input>
    
    <input type="multiselect" token="filter_severity">
      <label>Severity</label>
      <choice value="*">All Severities</choice>
      <default>*</default>
      <fieldForLabel>severity</fieldForLabel>
      <fieldForValue>severity</fieldForValue>
      <search>
        <query>index=* sourcetype="trellix_epo:threat_events" | stats count by severity | sort severity</query>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </search>
    </input>
    
    <input type="dropdown" token="filter_dat_version">
      <label>DAT Version</label>
      <choice value="*">All Versions</choice>
      <default>*</default>
      <fieldForLabel>dat_version</fieldForLabel>
      <fieldForValue>dat_version</fieldForValue>
      <search>
        <query>index=* sourcetype="trellix_epo:host_status" OR sourcetype="trellix_epo:updates" | stats latest(_time) as latest_time by dat_version | sort -latest_time</query>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </search>
    </input>
  </fieldset>
  
  <row>
    <panel>
      <title>🛡 Security Overview</title>
      <row>
        <panel>
          <single>
            <title>Total Threats (24h)</title>
            <search>
              <query>index=* sourcetype="trellix_epo:threat_events" 
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$" threat_type="$filter_threat_type$" severity="$filter_severity$"
| stats count as threat_count</query>
              <earliest>-24h@h</earliest>
              <latest>now</latest>
            </search>
            <option name="colorMode">none</option>
            <option name="drilldown">none</option>
            <option name="numberPrecision">0</option>
            <option name="rangeColors">["0x65a637","0x65a637","0x65a637"]</option>
            <option name="rangeValues">[0]</option>
            <option name="showSparkline">false</option>
            <option name="showTrendIndicator">true</option>
            <option name="trendColorInterpretation">standard</option>
            <option name="trendDisplayMode">absolute</option>
            <option name="trendInterval">-7d@d</option>
            <option name="unit">Threats</option>
            <option name="unitPosition">after</option>
            <option name="useColors">false</option>
          </single>
        </panel>
        
        <panel>
          <single>
            <title>Total Threats (7d)</title>
            <search>
              <query>index=* sourcetype="trellix_epo:threat_events" 
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$" threat_type="$filter_threat_type$" severity="$filter_severity$"
| stats count as threat_count</query>
              <earliest>-7d@d</earliest>
              <latest>now</latest>
            </search>
            <option name="colorMode">none</option>
            <option name="drilldown">none</option>
            <option name="numberPrecision">0</option>
            <option name="rangeColors">["0x65a637","0x65a637","0x65a637"]</option>
            <option name="rangeValues">[0]</option>
            <option name="showSparkline">false</option>
            <option name="showTrendIndicator">true</option>
            <option name="trendColorInterpretation">standard</option>
            <option name="trendDisplayMode">absolute</option>
            <option name="trendInterval">-14d@d</option>
            <option name="unit">Threats</option>
            <option name="unitPosition">after</option>
            <option name="useColors">false</option>
          </single>
        </panel>
        
        <panel>
          <single>
            <title>Infected Hosts</title>
            <search>
              <query>index=* sourcetype="trellix_epo:threat_events" OR sourcetype="trellix_epo:malware_detections"
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$"
| stats dc(host) as infected_hosts</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="colorMode">none</option>
            <option name="drilldown">none</option>
            <option name="numberPrecision">0</option>
            <option name="rangeColors">["0xd93f3b","0xd93f3b","0xd93f3b"]</option>
            <option name="rangeValues">[0]</option>
            <option name="showSparkline">false</option>
            <option name="showTrendIndicator">true</option>
            <option name="trendColorInterpretation">standard</option>
            <option name="trendDisplayMode">absolute</option>
            <option name="trendInterval">-7d@d</option>
            <option name="unit">Hosts</option>
            <option name="unitPosition">after</option>
            <option name="useColors">false</option>
          </single>
        </panel>
        
        <panel>
