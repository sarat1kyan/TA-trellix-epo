| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$" file_hash!=""
| stats count as detection_count, dc(host) as affected_hosts, values(malware_name) as malware_names, values(file_path) as file_paths by file_hash
| sort -detection_count
