            <option name="trendInterval">-7d@d</option>
            <option name="unit">Hosts</option>
            <option name="unitPosition">after</option>
            <option name="useColors">false</option>
          </single>
        </panel>
      </row>
      
      <row>
        <panel>
          <title>Policy Compliance Status</title>
          <chart>
            <search>
              <query>index=* sourcetype="trellix_epo:policy_compliance"
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$"
| stats count as policy_count by compliance_status
| sort compliance_status</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="charting.chart">pie</option>
            <option name="charting.chart.nullValueMode">zero</option>
            <option name="charting.chart.showDataLabels">none</option>
            <option name="charting.drilldown">none</option>
            <option name="refresh.display">progressbar</option>
          </chart>
        </panel>
        
        <panel>
          <title>Policy Violations Over Time</title>
          <chart>
            <search>
              <query>index=* sourcetype="trellix_epo:policy_compliance"
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$" compliance_status="Non-Compliant" OR compliance_status="Violation"
| bin _time span=1h
| stats sum(violation_count) as violations by _time
| sort _time</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="charting.chart">line</option>
            <option name="charting.chart.nullValueMode">zero</option>
            <option name="charting.chart.showDataLabels">none</option>
            <option name="charting.drilldown">none</option>
            <option name="refresh.display">progressbar</option>
          </chart>
        </panel>
      </row>
      
      <row>
        <panel>
          <title>Top Policy Violations</title>
          <table>
            <search>
              <query>index=* sourcetype="trellix_epo:policy_compliance"
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$" compliance_status="Non-Compliant" OR compliance_status="Violation"
| stats sum(violation_count) as total_violations, dc(host) as affected_hosts by policy_name
| sort -total_violations
| head 20</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="count">20</option>
            <option name="dataOverlayMode">none</option>
            <option name="drilldown">none</option>
            <option name="percentagesRow">false</option>
            <option name="rowNumbers">false</option>
            <option name="totalsRow">false</option>
            <option name="wrap">true</option>
          </table>
        </panel>
      </row>
    </panel>
  </row>
  
  <row>
    <panel>
      <title>👤 User Activity</title>
      <row>
        <panel>
          <single>
            <title>Total User Actions</title>
            <search>
              <query>index=* sourcetype="trellix_epo:user_actions"
| stats count as action_count</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="colorMode">none</option>
            <option name="drilldown">none</option>
            <option name="numberPrecision">0</option>
            <option name="rangeColors">["0x53a051","0x53a051","0x53a051"]</option>
            <option name="rangeValues">[0]</option>
            <option name="showSparkline">false</option>
            <option name="showTrendIndicator">true</option>
            <option name="trendColorInterpretation">standard</option>
            <option name="trendDisplayMode">absolute</option>
            <option name="trendInterval">-7d@d</option>
            <option name="unit">Actions</option>
            <option name="unitPosition">after</option>
            <option name="useColors">false</option>
          </single>
        </panel>
        
        <panel>
          <single>
            <title>Failed Logins</title>
            <search>
              <query>index=* sourcetype="trellix_epo:user_actions"
| search action="*login*" result="*fail*" OR result="*denied*"
| stats count as failed_logins</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="colorMode">none</option>
            <option name="drilldown">none</option>
            <option name="numberPrecision">0</option>
            <option name="rangeColors">["0xd93f3b","0xd93f3b","0xd93f3b"]</option>
            <option name="rangeValues">[0]</option>
            <option name="showSparkline">false</option>
            <option name="showTrendIndicator">true</option>
            <option name="trendColorInterpretation">standard</option>
            <option name="trendDisplayMode">absolute</option>
            <option name="trendInterval">-7d@d</option>
            <option name="unit">Failed</option>
            <option name="unitPosition">after</option>
            <option name="useColors">false</option>
          </single>
        </panel>
        
        <panel>
          <single>
            <title>Admin Actions</title>
            <search>
              <query>index=* sourcetype="trellix_epo:user_actions"
| search action="*admin*" OR action="*delete*" OR action="*modify*" OR action="*create*"
| stats count as admin_actions</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="colorMode">none</option>
            <option name="drilldown">none</option>
            <option name="numberPrecision">0</option>
            <option name="rangeColors">["0xf1813f","0xf1813f","0xf1813f"]</option>
            <option name="rangeValues">[0]</option>
            <option name="showSparkline">false</option>
            <option name="showTrendIndicator">true</option>
            <option name="trendColorInterpretation">standard</option>
            <option name="trendDisplayMode">absolute</option>
            <option name="trendInterval">-7d@d</option>
            <option name="unit">Actions</option>
            <option name="unitPosition">after</option>
            <option name="useColors">false</option>
          </single>
        </panel>
      </row>
      
      <row>
        <panel>
          <title>Top Users by Activity</title>
          <chart>
            <search>
              <query>index=* sourcetype="trellix_epo:user_actions"
| stats count as action_count by user
| sort -action_count
| head 10</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="charting.chart">column</option>
            <option name="charting.chart.nullValueMode">zero</option>
            <option name="charting.chart.showDataLabels">none</option>
            <option name="charting.drilldown">none</option>
            <option name="refresh.display">progressbar</option>
          </chart>
        </panel>
        
        <panel>
          <title>User Actions Over Time</title>
          <chart>
            <search>
              <query>index=* sourcetype="trellix_epo:user_actions"
| bin _time span=1h
| stats count as action_count by _time, result
| sort _time result</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="charting.chart">line</option>
            <option name="charting.chart.nullValueMode">zero</option>
            <option name="charting.chart.showDataLabels">none</option>
            <option name="charting.chart.stackMode">stacked</option>
            <option name="charting.drilldown">none</option>
            <option name="refresh.display">progressbar</option>
          </chart>
        </panel>
      </row>
      
      <row>
        <panel>
          <title>Recent User Actions</title>
          <table>
            <search>
              <query>index=* sourcetype="trellix_epo:user_actions"
| sort -_time
| head 100
| table _time, user, action, result, object, src_ip</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="count">100</option>
            <option name="dataOverlayMode">none</option>
            <option name="drilldown">none</option>
            <option name="percentagesRow">false</option>
            <option name="rowNumbers">false</option>
            <option name="totalsRow">false</option>
            <option name="wrap">true</option>
          </table>
        </panel>
      </row>
    </panel>
  </row>
  
  <row>
    <panel>
      <title>📈 Advanced Analytics</title>
      <row>
        <panel>
          <title>Threat Heatmap by Hour</title>
          <chart>
            <search>
              <query>index=* sourcetype="trellix_epo:threat_events"
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$"
| eval hour=strftime(_time, "%H")
| eval day=strftime(_time, "%A")
| stats count as threat_count by day, hour
| eval day_num=case(
  day="Sunday", 0,
  day="Monday", 1,
  day="Tuesday", 2,
  day="Wednesday", 3,
  day="Thursday", 4,
  day="Friday", 5,
  day="Saturday", 6)
| sort day_num, hour</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="charting.chart">heatmap</option>
            <option name="charting.chart.nullValueMode">zero</option>
            <option name="charting.drilldown">none</option>
            <option name="refresh.display">progressbar</option>
          </chart>
        </panel>
      </row>
      
      <row>
        <panel>
          <title>Threat Severity vs Type Matrix</title>
          <chart>
            <search>
              <query>index=* sourcetype="trellix_epo:threat_events"
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$" threat_type="$filter_threat_type$" severity="$filter_severity$"
| stats count as threat_count by severity, threat_type
| sort severity, threat_type</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="charting.chart">heatmap</option>
            <option name="charting.chart.nullValueMode">zero</option>
            <option name="charting.drilldown">none</option>
            <option name="refresh.display">progressbar</option>
          </chart>
        </panel>
        
        <panel>
          <title>Quarantine Events</title>
          <chart>
            <search>
              <query>index=* sourcetype="trellix_epo:quarantine_events"
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$"
| bin _time span=1h
| stats count as quarantine_count by _time, quarantine_action
| sort _time, quarantine_action</query>
              <earliest>$time_range.earliest$</earliest>
              <latest>$time_range.latest$</latest>
            </search>
            <option name="charting.chart">line</option>
            <option name="charting.chart.nullValueMode">zero</option>
