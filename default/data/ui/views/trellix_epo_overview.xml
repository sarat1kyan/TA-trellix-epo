            <search>
              <query>index=* sourcetype="trellix_epo:malware_detections"
| eval host_filter=if("$filter_host$"=="*", "*", host)
| search host_filter="$filter_host$"
| stats count as detection_count by malware_name
| sort -detection_count
| head 10</query>
